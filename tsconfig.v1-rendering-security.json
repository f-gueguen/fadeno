  "compilerOptions": {
    "allowImportingTsExtensions": true,
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "noEmit": true,
    "types": ["node"]
  },
  "include": [
    "packages/framework/src/index.ts",
    "packages/framework/src/internal/unsafe-html.ts",
    "packages/framework/dist/**/*.d.ts",
