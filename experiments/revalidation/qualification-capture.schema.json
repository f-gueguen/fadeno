{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fadeno.dev/schemas/experiment/revalidation-qualification-capture-v1.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "sourceCommit", "environmentId", "status", "inputHashes", "preflight", "failures"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "sourceCommit": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
    "environmentId": { "const": "k0-h4-local-docker-arm64-v1" },
    "status": { "enum": ["complete", "inconclusive"] },
    "inputHashes": { "type": "object", "additionalProperties": false, "required": ["environment", "workload", "baselines", "schedule", "scheduleGolden", "dependencyLock"], "properties": { "environment": { "$ref": "#/$defs/sha256" }, "workload": { "$ref": "#/$defs/sha256" }, "baselines": { "$ref": "#/$defs/sha256" }, "schedule": { "$ref": "#/$defs/sha256" }, "scheduleGolden": { "$ref": "#/$defs/sha256" }, "dependencyLock": { "$ref": "#/$defs/sha256" } } },
    "preflight": { "type": "object", "additionalProperties": false, "required": ["identitySha256", "beforeAccepted", "afterAccepted", "beforeHostSha256", "afterHostSha256", "beforeContainerSha256", "afterContainerSha256"], "properties": { "identitySha256": { "$ref": "#/$defs/sha256" }, "beforeAccepted": { "type": "boolean" }, "afterAccepted": { "type": "boolean" }, "beforeHostSha256": { "$ref": "#/$defs/sha256" }, "afterHostSha256": { "$ref": "#/$defs/sha256" }, "beforeContainerSha256": { "$ref": "#/$defs/sha256" }, "afterContainerSha256": { "$ref": "#/$defs/sha256" } } },
    "correctness": { "$ref": "#/$defs/correctness" },
    "latency": { "$ref": "#/$defs/latency" },
    "memory": { "$ref": "#/$defs/memory" },
    "controls": { "type": "object", "additionalProperties": false, "required": ["unsafeKeepsDetected", "unsafeKeepsTotal", "comparisonPass", "sensitiveValuesDisclosed"], "properties": { "unsafeKeepsDetected": { "type": "integer", "minimum": 0, "maximum": 4 }, "unsafeKeepsTotal": { "const": 4 }, "comparisonPass": { "type": "boolean" }, "sensitiveValuesDisclosed": { "type": "boolean" } } },
    "failures": { "type": "array", "maxItems": 10000, "items": { "type": "object", "additionalProperties": false, "required": ["code"], "properties": { "code": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]{1,79}$" }, "cycleId": { "type": "string", "pattern": "^c[0-9]{5}$" } } } }
  },
  "allOf": [
    { "if": { "properties": { "status": { "const": "complete" } } }, "then": { "required": ["correctness", "latency", "memory", "controls"], "properties": { "correctness": {}, "latency": {}, "memory": {}, "controls": {}, "failures": { "type": "array", "maxItems": 0 }, "preflight": { "type": "object", "properties": { "beforeAccepted": { "const": true }, "afterAccepted": { "const": true } } } } } },
    { "if": { "properties": { "status": { "const": "inconclusive" } } }, "then": { "properties": { "failures": { "type": "array", "minItems": 1 } } } }
  ],
  "$defs": {
    "correctness": { "type": "object", "additionalProperties": false, "required": ["cycles"], "properties": { "cycles": { "type": "array", "minItems": 10000, "maxItems": 10000, "items": { "type": "object", "additionalProperties": false, "required": ["id", "path", "readOrder", "beforeDigest", "defaultDigest", "selectiveDigest", "defaultExecutions", "selectiveExecutions", "defaultActionStatus", "selectiveActionStatus", "stateIsolated", "stale"], "properties": { "id": { "type": "string", "pattern": "^c[0-9]{5}$" }, "path": { "enum": ["s", "e"] }, "readOrder": { "type": "string", "pattern": "^[0-8]{9}$" }, "beforeDigest": { "$ref": "#/$defs/sha256" }, "defaultDigest": { "$ref": "#/$defs/sha256" }, "selectiveDigest": { "$ref": "#/$defs/sha256" }, "defaultExecutions": { "type": "string", "pattern": "^[0-9]{6}$" }, "selectiveExecutions": { "type": "string", "pattern": "^[0-9]{6}$" }, "defaultActionStatus": { "enum": ["success", "expected-error"] }, "selectiveActionStatus": { "enum": ["success", "expected-error"] }, "stateIsolated": { "type": "boolean" }, "stale": { "type": "boolean" } } } } } },
    "latency": { "type": "object", "additionalProperties": false, "required": ["defaultNs", "selectiveNs", "rounds", "outputsMatch"], "properties": { "defaultNs": { "$ref": "#/$defs/samples" }, "selectiveNs": { "$ref": "#/$defs/samples" }, "rounds": { "type": "array", "minItems": 1000, "maxItems": 1000, "items": { "type": "object", "additionalProperties": false, "required": ["round", "firstPath", "defaultNs", "selectiveNs", "defaultOutputDigest", "selectiveOutputDigest"], "properties": { "round": { "type": "integer", "minimum": 0, "maximum": 999 }, "firstPath": { "enum": ["default", "selective"] }, "defaultNs": { "type": "integer", "minimum": 1 }, "selectiveNs": { "type": "integer", "minimum": 1 }, "defaultOutputDigest": { "$ref": "#/$defs/sha256" }, "selectiveOutputDigest": { "$ref": "#/$defs/sha256" } } } }, "outputsMatch": { "type": "boolean" } } },
    "memory": { "type": "object", "additionalProperties": false, "required": ["gcAvailable", "gcRounds", "baselineRss", "afterRss", "baselineHeapUsed", "afterHeapUsed", "baselineCgroupMemory", "afterCgroupMemory", "checkpoints"], "properties": { "gcAvailable": { "const": true }, "gcRounds": { "const": 3 }, "baselineRss": { "type": "integer", "minimum": 1 }, "afterRss": { "type": "integer", "minimum": 1 }, "baselineHeapUsed": { "type": "integer", "minimum": 1 }, "afterHeapUsed": { "type": "integer", "minimum": 1 }, "baselineCgroupMemory": { "type": "integer", "minimum": 1 }, "afterCgroupMemory": { "type": "integer", "minimum": 1 }, "checkpoints": { "type": "array", "minItems": 10, "maxItems": 10, "items": { "type": "integer", "minimum": 1 } } } },
    "samples": { "type": "array", "minItems": 1000, "maxItems": 1000, "items": { "type": "integer", "minimum": 1 } },
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
  }
}
