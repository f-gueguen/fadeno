{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fadeno.dev/schemas/experiment/revalidation-qualification-contract-v1.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "schemaVersion", "visibility", "environment", "inputs", "correctness", "latency", "memory", "controls", "environmentPolicy", "attemptPolicy", "decision", "capabilitySlice", "executionSlice"],
  "properties": {
    "$schema": { "const": "https://fadeno.dev/schemas/experiment/revalidation-qualification-contract-v1.json" },
    "schemaVersion": { "const": 1 },
    "visibility": { "const": "private-qualification-contract" },
    "environment": { "const": { "id": "k0-h4-local-docker-arm64-v1", "path": "experiments/revalidation/reference-environment.json", "sha256": "9ef3f788960631c4aebca12eaf33ba1b168cf56ccdf96aa06cf48aba73571acf" } },
    "inputs": { "const": {
      "workload": { "path": "experiments/revalidation/workload.json", "sha256": "44703abf085e34ba9b88bea790c4955cd2f68804b2573dfdc6a46c3022c56f53" },
      "baselines": { "path": "experiments/revalidation/baseline-manifests.json", "sha256": "7613c10852d8c4f57978c525f733d4011e0129a10ed7b1c4cefe7f54c8564e3a" },
      "schedule": { "path": "experiments/revalidation/qualification-schedule.json", "sha256": "6a3bb897a8ba375dfe13e1e809a57e4975e17fbcd9b8b08e6326e19fca715c2c", "cycles": 10000, "successCycles": 8056, "expectedErrorCycles": 1944 },
      "scheduleGolden": { "path": "experiments/revalidation/qualification-schedule.golden.json", "sha256": "a17ddc3354e61b97a8c2636cafaa3eee79bfe67080a38ff9fa7685ab78c8a4a0" },
      "dependencyLock": { "path": "pnpm-lock.yaml", "sha256": "2fd513727b54e906b09a03d5e77104eb2f766703bf4eeb9ec1c670446fee492a" }
    } },
    "correctness": { "const": { "cycles": 10000, "statePolicy": "fresh-equivalent-default-and-selective-state-per-cycle", "readOrder": "schedule-permutation", "successPolicy": "target-false-before-and-true-after", "expectedErrorPolicy": "denied-action-and-unchanged-output", "deduplicationPolicy": "each-equivalent-resource-input-once-per-request", "outputPolicy": "default-and-selective-complete-output-digests-equal-schedule", "retries": 0 } },
    "latency": { "const": { "warmupsPerPath": 100, "samplesPerPath": 1000, "clock": "process.hrtime.bigint", "pairing": "fresh-equivalent-state-per-path-per-round", "roundOrder": "alternate-default-first-selective-first", "setupBoundary": "state-and-pre-action-page-before-timer", "timedBoundary": "action-through-complete-output-materialization", "retries": 0, "percentile": { "name": "p95", "method": "nearest-rank", "index": "ceil(0.95 * count) - 1" }, "thresholds": { "defaultToSelectiveP95MaximumRatio": 2, "defaultP95MaximumMilliseconds": 300 } } },
    "memory": { "const": { "warmupCycles": 100, "measuredCycles": 10000, "processMetric": "rss", "diagnosticMetrics": ["heapUsed", "cgroup.memory.current"], "gc": { "required": true, "nodeFlag": "--expose-gc", "rounds": 3, "stabilizationTurnsPerRound": 3 }, "checkpointInterval": 1000, "formula": "(afterRss - baselineRss) / baselineRss", "maximumGrowthRatio": 0.1, "missingGcPolicy": "inconclusive-no-decision" } },
    "controls": { "const": { "unsafeKeeps": { "detected": 4, "total": 4 }, "comparison": { "required": ["value", "expected-error", "ordering"], "refuses": ["non-cacheable", "unsupported-json"] }, "sensitiveValues": ["secretCanary", "principalId", "tenantId"], "textArtifactScan": "all-retained-stdout-stderr-diagnostics-failures-and-json" } },
    "environmentPolicy": { "const": { "phases": ["before-warmup", "after-all-phases"], "hostSamplesPerPhase": 3, "requiredContainerFields": ["cpuThrottledRatio", "oom", "oomKill", "pidsCurrent", "networkDisabled", "memoryCurrent"], "failurePolicy": "retain-inconclusive-attempt-no-decision" } },
    "attemptPolicy": { "const": { "allocateBeforePreflight": true, "retainEveryLaunchedAttempt": true, "validAttemptRetries": 0, "environmentalRetryOnly": true, "decisionAttempt": "first-complete-reference-valid-attempt" } },
    "decision": { "const": { "go": "all-h4-product-gates-pass", "pivot": "any-correctness-deduplication-latency-memory-keeps-or-comparison-gate-fails", "inconclusive": "environment-or-evidence-integrity-fails", "narrowAllowed": false } },
    "capabilitySlice": { "const": { "slice": "K0-10A", "immutableResultsAllowed": false, "decisionAllowed": false } },
    "executionSlice": { "const": { "slice": "K0-10B", "requiredSource": "exact-clean-merged-k0-10a-main-commit" } }
  }
}
