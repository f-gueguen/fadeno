{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fadeno.dev/schemas/experiment/type-spine-qualification-corpus-v1.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "schemaVersion", "visibility", "seed", "changedRouteId", "inputA", "inputB", "topology"],
  "properties": {
    "$schema": { "const": "https://fadeno.dev/schemas/experiment/type-spine-qualification-corpus-v1.json" },
    "schemaVersion": { "const": 1 },
    "visibility": { "const": "private-qualification-corpus" },
    "seed": { "const": "fadeno-k0-h3-corpus-v1" },
    "changedRouteId": { "type": "string", "pattern": "^[a-z][a-z0-9]{0,31}$" },
    "inputA": { "$ref": "#/$defs/input" },
    "inputB": { "$ref": "#/$defs/input" },
    "topology": {
      "type": "array",
      "minItems": 1000,
      "maxItems": 1000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["routeId", "parentRouteId", "depth"],
        "properties": {
          "routeId": { "$ref": "#/$defs/id" },
          "parentRouteId": { "oneOf": [{ "$ref": "#/$defs/id" }, { "type": "null" }] },
          "depth": { "type": "integer", "minimum": 0, "maximum": 8 }
        }
      }
    }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9]{0,31}$" },
    "entry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key", "type"],
      "properties": {
        "key": { "$ref": "#/$defs/id" },
        "type": { "enum": ["boolean", "number", "string"] }
      }
    },
    "input": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "visibility", "routes", "forms", "context"],
      "properties": {
        "schemaVersion": { "const": 1 },
        "visibility": { "const": "private-harness-control" },
        "routes": {
          "type": "array", "minItems": 1000, "maxItems": 1000,
          "items": {
            "type": "object", "additionalProperties": false, "required": ["id", "parameters"],
            "properties": {
              "id": { "$ref": "#/$defs/id" },
              "parameters": { "type": "array", "maxItems": 3, "items": { "$ref": "#/$defs/entry" } }
            }
          }
        },
        "forms": {
          "type": "array", "minItems": 50, "maxItems": 50,
          "items": {
            "type": "object", "additionalProperties": false, "required": ["id", "fields"],
            "properties": {
              "id": { "$ref": "#/$defs/id" },
              "fields": { "type": "array", "minItems": 1, "maxItems": 3, "items": { "$ref": "#/$defs/entry" } }
            }
          }
        },
        "context": { "type": "array", "minItems": 9, "maxItems": 9, "items": { "$ref": "#/$defs/entry" } }
      }
    }
  }
}
