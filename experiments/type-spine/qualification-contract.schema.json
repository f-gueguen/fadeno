{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fadeno.dev/schemas/experiment/type-spine-qualification-contract-v1.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "schemaVersion", "visibility", "environmentId", "corpus", "measurement", "stockTypeScript", "requiredGates", "decision", "capabilitySlice", "executionSlice"],
  "properties": {
    "$schema": { "const": "https://fadeno.dev/schemas/experiment/type-spine-qualification-contract-v1.json" },
    "schemaVersion": { "const": 1 },
    "visibility": { "const": "private-qualification-contract" },
    "environmentId": { "const": "k0-h3-local-docker-arm64-v1" },
    "corpus": {
      "type": "object", "additionalProperties": false,
      "required": ["path", "sha256", "routes", "changedRouteId", "outputA", "outputB"],
      "properties": {
        "path": { "const": "experiments/type-spine/qualification-corpus.json" },
        "sha256": { "$ref": "#/$defs/hash" }, "routes": { "const": 1000 },
        "changedRouteId": { "type": "string" }, "outputA": { "$ref": "#/$defs/hash" }, "outputB": { "$ref": "#/$defs/hash" }
      }
    },
    "measurement": {
      "type": "object", "additionalProperties": false,
      "required": ["warmups", "samples", "retries", "clock", "processPolicy", "roundOrder", "incrementalVariants", "percentile", "thresholds"],
      "properties": {
        "warmups": { "const": 5 }, "samples": { "const": 20 }, "retries": { "const": 0 },
        "clock": { "const": "process.hrtime.bigint" }, "processPolicy": { "const": "fresh-child-per-sample" },
        "roundOrder": { "const": ["clean-generator", "stock-tsc-no-emit", "incremental-generator"] },
        "incrementalVariants": { "const": ["A-to-B", "B-to-A"] },
        "percentile": { "const": { "name": "p95", "method": "nearest-rank", "index": "ceil(0.95 * count) - 1" } },
        "thresholds": { "const": { "cleanGeneratorToTscMaximumRatio": 1.5, "incrementalToCleanMaximumRatio": 0.25 } }
      }
    },
    "stockTypeScript": {
      "type": "object", "additionalProperties": false,
      "required": ["version", "tscExecutable", "tsserverExecutable", "compilerArguments", "languageServiceCommands"],
      "properties": {
        "version": { "const": "7.0.2" },
        "tscExecutable": { "const": "node_modules/typescript/bin/tsc" },
        "tsserverExecutable": { "const": "node_modules/typescript/bin/tsserver" },
        "compilerArguments": { "type": "array", "minItems": 15, "maxItems": 15, "items": { "type": "string" } },
        "languageServiceCommands": { "const": ["open", "quickinfo", "definition"] }
      }
    },
    "requiredGates": { "const": ["valid-consumers", "invalid-source-diagnostics", "byte-determinism", "stale-output", "stock-tsc", "stock-tsserver", "clean-latency", "incremental-latency"] },
    "decision": { "const": { "go": "all-gates-pass", "narrow": "all-non-performance-gates-pass-and-any-latency-gate-fails", "pivot": "any-correctness-determinism-stale-or-stock-tool-gate-fails", "inconclusive": "environment-preflight-postflight-or-evidence-integrity-fails" } },
    "capabilitySlice": { "const": { "slice": "K0-08A", "immutableResultsAllowed": false, "decisionAllowed": false } },
    "executionSlice": { "const": { "slice": "K0-08B", "requiredSource": "exact-clean-merged-k0-08a-main-commit", "publishEveryReferenceValidAttempt": true } }
  },
  "$defs": { "hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" } }
}
