{
  "$schema": "https://fadeno.dev/schemas/experiment/type-spine-qualification-contract-v1.json",
  "schemaVersion": 1,
  "visibility": "private-qualification-contract",
  "environmentId": "k0-h3-local-docker-arm64-v1",
  "corpus": {
    "path": "experiments/type-spine/qualification-corpus.json",
    "sha256": "5e02dab58aec54fab912876aff32c91fa4bcdd5a4be5f4723c1b2c725e6a84c4",
    "routes": 1000,
    "changedRouteId": "r0999",
    "outputA": "eb98472c8a9bfa5c1902fa2c127d0343be9e9dba27377453909441d26fbff421",
    "outputB": "3033291eb9cb6875ceca30b17e1fcc4829f9d86658af41ba5ceb3cde71da2037"
  },
  "measurement": {
    "warmups": 5,
    "samples": 20,
    "retries": 0,
    "clock": "process.hrtime.bigint",
    "processPolicy": "fresh-child-per-sample",
    "roundOrder": ["clean-generator", "stock-tsc-no-emit", "incremental-generator"],
    "incrementalVariants": ["A-to-B", "B-to-A"],
    "percentile": { "name": "p95", "method": "nearest-rank", "index": "ceil(0.95 * count) - 1" },
    "thresholds": { "cleanGeneratorToTscMaximumRatio": 1.5, "incrementalToCleanMaximumRatio": 0.25 }
  },
  "stockTypeScript": {
    "version": "7.0.2",
    "tscExecutable": "node_modules/typescript/bin/tsc",
    "languageServerExecutable": "node_modules/typescript/bin/tsc",
    "languageServerArguments": ["--lsp", "--stdio"],
    "compilerArguments": ["--noEmit", "--strict", "--target", "ES2022", "--module", "ESNext", "--moduleResolution", "Bundler", "--allowImportingTsExtensions", "--skipLibCheck", "false", "--incremental", "false", "--pretty", "false"],
    "languageServiceCommands": ["initialize", "textDocument/didOpen", "textDocument/hover", "textDocument/definition"]
  },
  "requiredGates": ["valid-consumers", "invalid-source-diagnostics", "byte-determinism", "stale-output", "stock-tsc", "stock-language-server", "clean-latency", "incremental-latency"],
  "decision": {
    "go": "all-gates-pass",
    "narrow": "all-non-performance-gates-pass-and-any-latency-gate-fails",
    "pivot": "any-correctness-determinism-stale-or-stock-tool-gate-fails",
    "inconclusive": "environment-preflight-postflight-or-evidence-integrity-fails"
  },
  "capabilitySlice": {
    "slice": "K0-08A",
    "immutableResultsAllowed": false,
    "decisionAllowed": false
  },
  "executionSlice": {
    "slice": "K0-08B",
    "requiredSource": "exact-clean-merged-k0-08a-main-commit",
    "publishEveryReferenceValidAttempt": true
  }
}
