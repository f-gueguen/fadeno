{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fadeno.dev/schemas/experiment/source-integration-attestations-v1.json",
  "title": "Fadeno K0 source integration attestations v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "schemaVersion", "attestations"],
  "properties": {
    "$schema": {
      "const": "https://fadeno.dev/schemas/experiment/source-integration-attestations-v1.json"
    },
    "schemaVersion": { "const": 1 },
    "attestations": {
      "type": "array",
      "maxItems": 64,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "repository",
          "experimentId",
          "manifestPath",
          "resultRunId",
          "sourceCommit",
          "method",
          "pullRequest",
          "integratedCommit"
        ],
        "properties": {
          "repository": {
            "type": "string",
            "pattern": "^https://github\\.com/[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$",
            "maxLength": 200
          },
          "experimentId": { "type": "string", "pattern": "^[a-z][a-z0-9-]{0,31}$" },
          "manifestPath": {
            "type": "string",
            "pattern": "^experiments/[a-z][a-z0-9-]*/results/[A-Za-z0-9._-]+/manifest\\.json$",
            "maxLength": 300
          },
          "resultRunId": { "type": "string", "minLength": 1, "maxLength": 100 },
          "sourceCommit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
          "method": { "const": "squash" },
          "pullRequest": { "type": "integer", "minimum": 1 },
          "integratedCommit": { "type": "string", "pattern": "^[0-9a-f]{40}$" }
        }
      }
    }
  }
}
