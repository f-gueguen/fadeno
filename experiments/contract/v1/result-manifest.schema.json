{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fadeno.dev/schemas/experiment/result-manifest-v1.json",
  "title": "Fadeno K0 experiment result manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schemaVersion",
    "experiment",
    "run",
    "source",
    "environment",
    "dependencyLock",
    "command",
    "workload",
    "measurements",
    "failures",
    "artifacts",
    "validator",
    "redaction",
    "conclusion"
  ],
  "properties": {
    "$schema": {
      "const": "https://fadeno.dev/schemas/experiment/result-manifest-v1.json"
    },
    "schemaVersion": { "const": 1 },
    "experiment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "contractVersion"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z][a-z-]{0,31}$" },
        "contractVersion": { "const": 1 }
      }
    },
    "run": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "attempt", "startedAt", "completedAt", "status"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[0-9]{8}T[0-9]{6}Z-[a-f0-9]{7,40}-a[1-9][0-9]*$",
          "maxLength": 80
        },
        "attempt": { "type": "integer", "minimum": 1, "maximum": 100 },
        "startedAt": { "$ref": "#/$defs/timestamp" },
        "completedAt": { "$ref": "#/$defs/timestamp" },
        "status": { "enum": ["passed", "failed", "inconclusive"] }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "commit", "dirty"],
      "properties": {
        "repository": { "const": "https://github.com/f-gueguen/fadeno" },
        "commit": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
        "dirty": { "const": false }
      }
    },
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["referenceId", "referenceClass", "host", "container", "toolchain", "browsers", "power", "backgroundLoad"],
      "properties": {
        "referenceId": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,63}$" },
        "referenceClass": { "enum": ["reference", "non-reference"] },
        "host": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "provider",
            "repositoryVisibility",
            "runnerLabel",
            "runnerImage",
            "runnerImageVersion",
            "runnerName",
            "operatingSystemVersion",
            "kernelVersion",
            "architecture",
            "cpuModel",
            "logicalCpuCount",
            "memoryMiB",
            "advertisedStorageMiB",
            "freeStorageMiB"
          ],
          "properties": {
            "provider": { "type": "string", "pattern": "^[a-z][a-z-]{0,31}$" },
            "repositoryVisibility": { "const": "private" },
            "runnerLabel": { "$ref": "#/$defs/shortString" },
            "runnerImage": { "$ref": "#/$defs/shortString" },
            "runnerImageVersion": { "$ref": "#/$defs/shortString" },
            "runnerName": { "$ref": "#/$defs/shortString" },
            "operatingSystemVersion": { "$ref": "#/$defs/shortString" },
            "kernelVersion": { "$ref": "#/$defs/shortString" },
            "architecture": { "enum": ["x64", "arm64"] },
            "cpuModel": { "type": "string", "minLength": 1, "maxLength": 160 },
            "logicalCpuCount": { "type": "integer", "minimum": 2, "maximum": 512 },
            "memoryMiB": { "type": "integer", "minimum": 8192, "maximum": 1048576 },
            "advertisedStorageMiB": { "type": "integer", "minimum": 14336, "maximum": 10485760 },
            "freeStorageMiB": { "type": "integer", "minimum": 4096, "maximum": 10485760 }
          }
        },
        "container": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "image",
            "indexDigest",
            "platform",
            "platformDigest",
            "configDigest",
            "executionUser",
            "browserSandbox",
            "networkPolicy"
          ],
          "properties": {
            "image": { "$ref": "#/$defs/digestImage" },
            "indexDigest": { "$ref": "#/$defs/sha256Digest" },
            "platform": { "type": "string", "pattern": "^[a-z0-9]+/[a-z0-9]+$", "maxLength": 40 },
            "platformDigest": { "$ref": "#/$defs/sha256Digest" },
            "configDigest": { "$ref": "#/$defs/sha256Digest" },
            "executionUser": { "enum": ["root", "non-root"] },
            "browserSandbox": { "enum": ["disabled-for-trusted-local-fixtures", "enabled"] },
            "networkPolicy": { "enum": ["trusted-local-fixtures-only", "network-disabled"] }
          }
        },
        "toolchain": {
          "type": "object",
          "additionalProperties": false,
          "required": ["node", "pnpm", "playwright"],
          "properties": {
            "node": { "$ref": "#/$defs/shortString" },
            "pnpm": { "$ref": "#/$defs/shortString" },
            "playwright": { "$ref": "#/$defs/shortString" }
          }
        },
        "browsers": {
          "type": "object",
          "additionalProperties": false,
          "required": ["chromeForTesting", "firefox", "webkit"],
          "properties": {
            "chromeForTesting": { "$ref": "#/$defs/shortString" },
            "firefox": { "$ref": "#/$defs/shortString" },
            "webkit": { "$ref": "#/$defs/shortString" }
          }
        },
        "power": {
          "type": "object",
          "additionalProperties": false,
          "required": ["policy", "telemetry"],
          "properties": {
            "policy": { "enum": ["provider-managed-continuous-power"] },
            "telemetry": { "enum": ["not-exposed"] }
          }
        },
        "backgroundLoad": {
          "type": "object",
          "additionalProperties": false,
          "required": ["preflightObservedAt", "loadAverage1m", "processCount", "accepted", "reason"],
          "properties": {
            "preflightObservedAt": { "$ref": "#/$defs/timestamp" },
            "loadAverage1m": { "type": "number", "minimum": 0, "maximum": 1024 },
            "processCount": { "type": "integer", "minimum": 1, "maximum": 100000 },
            "accepted": { "type": "boolean" },
            "reason": { "type": "string", "minLength": 1, "maxLength": 240 }
          }
        }
      }
    },
    "dependencyLock": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "artifact", "sha256"],
      "properties": {
        "path": { "const": "pnpm-lock.yaml" },
        "artifact": { "$ref": "#/$defs/relativePath" },
        "sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "command": {
      "type": "object",
      "additionalProperties": false,
      "required": ["cwd", "argv"],
      "properties": {
        "cwd": { "const": "." },
        "argv": {
          "type": "array",
          "minItems": 2,
          "maxItems": 32,
          "items": { "type": "string", "minLength": 1, "maxLength": 200 }
        }
      }
    },
    "workload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["dataset", "warmupIterations", "measuredIterations", "concurrency"],
      "properties": {
        "dataset": {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "artifact", "sha256"],
          "properties": {
            "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,79}$" },
            "sourcePath": { "$ref": "#/$defs/relativePath" },
            "artifact": { "$ref": "#/$defs/relativePath" },
            "sha256": { "$ref": "#/$defs/sha256" }
          }
        },
        "warmupIterations": { "type": "integer", "minimum": 0, "maximum": 1000000 },
        "measuredIterations": { "type": "integer", "minimum": 1, "maximum": 1000000 },
        "concurrency": { "type": "integer", "minimum": 1, "maximum": 1024 }
      }
    },
    "measurements": {
      "type": "array",
      "maxItems": 256,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "unit", "values"],
        "properties": {
          "name": { "type": "string", "pattern": "^[a-z][a-z0-9.-]{0,79}$" },
          "unit": { "type": "string", "pattern": "^[a-zA-Z%][a-zA-Z0-9%/.-]{0,31}$" },
          "values": {
            "type": "array",
            "minItems": 1,
            "maxItems": 1000000,
            "items": { "type": "number", "minimum": -1000000000000000, "maximum": 1000000000000000 }
          }
        }
      }
    },
    "failures": {
      "type": "array",
      "maxItems": 10000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["code", "message"],
        "properties": {
          "code": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]{1,79}$" },
          "message": { "type": "string", "minLength": 1, "maxLength": 1000 },
          "artifact": { "$ref": "#/$defs/relativePath" }
        }
      }
    },
    "artifacts": {
      "type": "array",
      "maxItems": 10000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "sha256", "bytes"],
        "properties": {
          "path": { "$ref": "#/$defs/relativePath" },
          "sha256": { "$ref": "#/$defs/sha256" },
          "bytes": { "type": "integer", "minimum": 0, "maximum": 1073741824 }
        }
      }
    },
    "validator": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version", "schemaId"],
      "properties": {
        "name": { "const": "fadeno-experiment-contract" },
        "version": { "const": 1 },
        "schemaId": { "const": "https://fadeno.dev/schemas/experiment/result-manifest-v1.json" }
      }
    },
    "redaction": {
      "type": "object",
      "additionalProperties": false,
      "required": ["policy", "fieldsRemoved"],
      "properties": {
        "policy": { "const": "fadeno-no-secrets-v1" },
        "fieldsRemoved": {
          "type": "array",
          "maxItems": 1000,
          "items": { "type": "string", "pattern": "^[a-zA-Z][a-zA-Z0-9.[\\]-]{0,159}$" }
        }
      }
    },
    "conclusion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "summary"],
      "properties": {
        "status": { "enum": ["pass", "fail", "inconclusive"] },
        "summary": { "type": "string", "minLength": 1, "maxLength": 2000 }
      }
    }
  },
  "$defs": {
    "digestImage": {
      "type": "string",
      "pattern": "^[a-z0-9.-]+/[a-z0-9._/-]+@sha256:[a-f0-9]{64}$",
      "maxLength": 500
    },
    "relativePath": {
      "type": "string",
      "minLength": 1,
      "maxLength": 240,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*(?:^|/)\\.(?:/|$))(?!.*\\\\)(?!.*//)[A-Za-z0-9._/-]+$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "sha256Digest": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "shortString": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "timestamp": {
      "type": "string",
      "format": "fadeno-utc-timestamp"
    }
  }
}
