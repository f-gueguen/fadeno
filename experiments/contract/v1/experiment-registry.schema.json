{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fadeno.dev/schemas/experiment/registry-v1.json",
  "title": "Fadeno K0 experiment registry v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "schemaVersion", "experiments"],
  "properties": {
    "$schema": {
      "const": "https://fadeno.dev/schemas/experiment/registry-v1.json"
    },
    "schemaVersion": { "const": 1 },
    "experiments": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "directory",
          "hypothesis",
          "command",
          "harnessSlice",
          "qualificationSlice",
          "status"
        ],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z][a-z-]{0,31}$" },
          "directory": { "type": "string", "pattern": "^[a-z][a-z-]{0,31}$" },
          "hypothesis": { "enum": ["H1", "H2", "H3", "H4"] },
          "command": { "type": "string", "pattern": "^pnpm experiment:[a-z-]+$", "maxLength": 80 },
          "harnessSlice": { "type": "string", "pattern": "^K0-[0-9]{2}$" },
          "qualificationSlice": { "type": "string", "pattern": "^K0-[0-9]{2}$" },
          "status": { "enum": ["planned", "available"] }
        }
      }
    }
  }
}
