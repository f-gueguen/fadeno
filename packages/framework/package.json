{
  "name": "fadeno-framework-internal",
  "version": "0.0.0-private",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=22.17.0"
  },
  "bin": {
    "fadeno": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./node": {
      "types": "./dist/node.d.ts",
      "import": "./dist/node.js"
    },
    "./jsx-runtime": {
      "types": "./dist/jsx-runtime.d.ts",
      "import": "./dist/jsx-runtime.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "check": "tsc -p tsconfig.build.json --noEmit && tsc -p tsconfig.neutral.json"
  }
}
