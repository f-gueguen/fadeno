{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fadeno.dev/contracts/rendering-security-v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion", "policyVersion", "futureConsumer", "classifierRegistrySha256", "textCases", "attributeCases", "sinkCases",
    "sinkRefusals", "urlKindSamples", "urlMatrix", "urlCases", "urlRefusals", "refusedContexts",
    "unsafeCapabilityOutcomes", "nonceCases", "redactionCases", "browserOutcomes"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "policyVersion": { "const": 1 },
    "futureConsumer": { "const": "V1-09 renderer and browser conformance" },
    "classifierRegistrySha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "textCases": { "type": "array", "minItems": 4, "items": { "$ref": "#/$defs/textCase" } },
    "attributeCases": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/attributeCase" } },
    "sinkCases": { "type": "array", "minItems": 8, "items": { "$ref": "#/$defs/sinkCase" } },
    "sinkRefusals": { "type": "array", "minItems": 15, "items": { "$ref": "#/$defs/sinkRefusal" } },
    "urlKindSamples": {
      "type": "object", "additionalProperties": false,
      "required": ["relative", "network-path", "http", "https", "mailto", "tel"],
      "properties": {
        "relative": { "type": "string" }, "network-path": { "type": "string" }, "http": { "type": "string" },
        "https": { "type": "string" }, "mailto": { "type": "string" }, "tel": { "type": "string" }
      }
    },
    "urlMatrix": {
      "type": "object", "additionalProperties": false,
      "required": ["a.href", "area.href", "form.action", "button.formaction", "input.formaction", "img.src", "source.src", "audio.src", "video.src", "video.poster", "link.href"],
      "properties": {
        "a.href": { "$ref": "#/$defs/urlKinds" }, "area.href": { "$ref": "#/$defs/urlKinds" },
        "form.action": { "$ref": "#/$defs/urlKinds" }, "button.formaction": { "$ref": "#/$defs/urlKinds" },
        "input.formaction": { "$ref": "#/$defs/urlKinds" }, "img.src": { "$ref": "#/$defs/urlKinds" },
        "source.src": { "$ref": "#/$defs/urlKinds" }, "audio.src": { "$ref": "#/$defs/urlKinds" },
        "video.src": { "$ref": "#/$defs/urlKinds" }, "video.poster": { "$ref": "#/$defs/urlKinds" },
        "link.href": { "$ref": "#/$defs/urlKinds" }
      }
    },
    "urlCases": { "type": "array", "minItems": 8, "items": { "$ref": "#/$defs/urlCase" } },
    "urlRefusals": { "type": "array", "minItems": 15, "items": { "$ref": "#/$defs/urlRefusal" } },
    "refusedContexts": { "type": "array", "minItems": 15, "uniqueItems": true, "items": { "type": "string" } },
    "unsafeCapabilityOutcomes": { "type": "array", "minItems": 4, "uniqueItems": true, "items": { "type": "string" } },
    "nonceCases": {
      "type": "array", "minItems": 2, "maxItems": 2,
      "items": {
        "oneOf": [
          { "type": "object", "additionalProperties": false, "required": ["id", "minimumEntropyBits", "encoding", "outputLength", "distinctSamples"], "properties": { "id": { "const": "default-primitive" }, "minimumEntropyBits": { "const": 128 }, "encoding": { "const": "base64url-unpadded" }, "outputLength": { "const": 22 }, "distinctSamples": { "type": "integer", "minimum": 64 } } },
          { "type": "object", "additionalProperties": false, "required": ["id", "rawInput", "receivesNonce"], "properties": { "id": { "const": "raw-non-blessing" }, "rawInput": { "type": "string" }, "receivesNonce": { "const": false } } }
        ]
      }
    },
    "redactionCases": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/redactionCase" } },
    "browserOutcomes": {
      "type": "array", "minItems": 4, "maxItems": 4,
      "items": {
        "oneOf": [
          { "$ref": "#/$defs/browserText" },
          { "$ref": "#/$defs/browserRcdata" },
          { "$ref": "#/$defs/browserUrl" },
          { "$ref": "#/$defs/browserCsp" }
        ]
      }
    }
  },
  "$defs": {
    "textCase": { "type": "object", "additionalProperties": false, "required": ["id", "context", "input", "output"], "properties": { "id": { "type": "string" }, "context": { "enum": ["html-text", "rcdata-title", "rcdata-textarea"] }, "input": { "type": "string" }, "output": { "type": "string" } } },
    "attributeCase": { "type": "object", "additionalProperties": false, "required": ["id", "element", "attribute", "input", "output"], "properties": { "id": { "type": "string" }, "element": { "type": "string" }, "attribute": { "type": "string" }, "input": { "type": "string" }, "output": { "type": "string" } } },
    "sinkCase": { "type": "object", "additionalProperties": false, "required": ["id", "element", "attribute", "kind"], "properties": { "id": { "type": "string" }, "element": { "type": "string" }, "attribute": { "type": ["string", "null"] }, "kind": { "type": "string" } } },
    "sinkRefusal": { "type": "object", "additionalProperties": false, "required": ["id", "element", "attribute", "error"], "properties": { "id": { "type": "string" }, "element": { "type": "string" }, "attribute": { "type": ["string", "null"] }, "error": { "type": "string" } } },
    "urlKinds": { "type": "array", "minItems": 4, "uniqueItems": true, "items": { "enum": ["relative", "network-path", "http", "https", "mailto", "tel"] } },
    "urlCase": { "type": "object", "additionalProperties": false, "required": ["id", "sink", "input", "output"], "properties": { "id": { "type": "string" }, "sink": { "type": "string" }, "input": { "type": "string" }, "output": { "type": "string" } } },
    "urlRefusal": { "type": "object", "additionalProperties": false, "required": ["id", "sink", "input", "error"], "properties": { "id": { "type": "string" }, "sink": { "type": "string" }, "input": { "type": "string" }, "error": { "type": "string" } } },
    "redactionCase": { "type": "object", "additionalProperties": false, "required": ["id", "source", "sensitiveFields", "sensitiveValues", "output"], "properties": { "id": { "type": "string" }, "source": { "type": "object" }, "sensitiveFields": { "type": "array", "items": { "type": "string" } }, "sensitiveValues": { "type": "array", "items": { "type": "string" } }, "output": { "type": "object" } } },
    "browserText": { "type": "object", "additionalProperties": false, "required": ["id", "phase", "inputCase", "expected"], "properties": { "id": { "const": "text-no-created-element" }, "phase": { "const": "V1-09" }, "inputCase": { "const": "text-delimiters" }, "expected": { "type": "object", "additionalProperties": false, "required": ["elementChildren", "text"], "properties": { "elementChildren": { "const": 0 }, "text": { "type": "string" } } } } },
    "browserRcdata": { "type": "object", "additionalProperties": false, "required": ["id", "phase", "inputCase", "expected"], "properties": { "id": { "const": "rcdata-no-end-tag-breakout" }, "phase": { "const": "V1-09" }, "inputCase": { "const": "title-end-tag" }, "expected": { "type": "object", "additionalProperties": false, "required": ["titleElements", "scriptElements", "text"], "properties": { "titleElements": { "const": 1 }, "scriptElements": { "const": 0 }, "text": { "type": "string" } } } } },
    "browserUrl": { "type": "object", "additionalProperties": false, "required": ["id", "phase", "inputCase", "expected"], "properties": { "id": { "const": "url-no-script-navigation" }, "phase": { "const": "V1-09" }, "inputCase": { "const": "javascript" }, "expected": { "type": "object", "additionalProperties": false, "required": ["renderRefused", "scriptNavigation"], "properties": { "renderRefused": { "const": true }, "scriptNavigation": { "const": false } } } } },
    "browserCsp": { "type": "object", "additionalProperties": false, "required": ["id", "phase", "input", "expected"], "properties": { "id": { "const": "csp-correlated-execution" }, "phase": { "const": "V1-09" }, "input": { "type": "object", "additionalProperties": false, "required": ["frameworkScriptId", "rawScriptId"], "properties": { "frameworkScriptId": { "type": "string" }, "rawScriptId": { "type": "string" } } }, "expected": { "type": "object", "additionalProperties": false, "required": ["executedIds", "violations"], "properties": { "executedIds": { "type": "array", "items": { "type": "string" } }, "violations": { "type": "array", "items": { "type": "string" } } } } } }
  }
}
