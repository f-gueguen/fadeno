  "refusalCases": [
    { "id": "write-before-head", "action": "write-before-head", "error": "FADENO_STREAM_WRITE_PHASE" },
    { "id": "double-head", "action": "double-head", "error": "FADENO_STREAM_HEAD_ALREADY_PUBLISHED" },
    { "id": "wrong-precommit-status", "action": "wrong-precommit-status", "error": "FADENO_STREAM_PRECOMMIT_OUTCOME" },
    { "id": "complete-before-head", "action": "complete-before-head", "error": "FADENO_STREAM_COMPLETE_PHASE" },
    { "id": "concurrent-write", "action": "concurrent-write", "error": "FADENO_STREAM_BACKPRESSURE" },
    { "id": "uncorrelated-nonce", "action": "uncorrelated-nonce", "error": "FADENO_STREAM_NONCE_CORRELATION" },
    { "id": "forged-nonce", "action": "forged-nonce", "error": "FADENO_STREAM_NONCE_AUTHORITY" },
    { "id": "unused-nonce", "action": "unused-nonce", "error": "FADENO_STREAM_NONCE_UNUSED" }
  ],
  "boundaryCases": [
    { "id": "nearest-child-fallback", "failed": "child", "fallbackFailures": [], "boundaries": [{ "id": "root", "active": true, "emitted": false }, { "id": "child", "parentId": "root", "active": true, "emitted": false }], "expected": { "kind": "fallback", "ownerId": "child" } },
    { "id": "child-fallback-escalates", "failed": "child", "fallbackFailures": ["child"], "boundaries": [{ "id": "root", "active": true, "emitted": false }, { "id": "child", "parentId": "root", "active": true, "emitted": false }], "expected": { "kind": "fallback", "ownerId": "root" } },
    { "id": "parent-fallback-also-fails", "failed": "child", "fallbackFailures": ["child", "root"], "boundaries": [{ "id": "root", "active": true, "emitted": false }, { "id": "child", "parentId": "root", "active": true, "emitted": false }], "expected": { "kind": "terminate" } },
    { "id": "partial-child-terminates", "failed": "child", "fallbackFailures": [], "boundaries": [{ "id": "root", "active": true, "emitted": false }, { "id": "child", "parentId": "root", "active": true, "emitted": true }], "expected": { "kind": "terminate" } },
    { "id": "inactive-child-uses-parent", "failed": "child", "fallbackFailures": [], "boundaries": [{ "id": "root", "active": true, "emitted": false }, { "id": "child", "parentId": "root", "active": false, "emitted": false }], "expected": { "kind": "fallback", "ownerId": "root" } }
  ],
  "boundaryRefusalCases": [
    { "id": "duplicate-boundary", "failed": "root", "boundaries": [{ "id": "root", "active": true, "emitted": false }, { "id": "root", "active": true, "emitted": false }], "error": "FADENO_STREAM_BOUNDARY_DUPLICATE" },
    { "id": "unknown-boundary", "failed": "missing", "boundaries": [{ "id": "root", "active": true, "emitted": false }], "error": "FADENO_STREAM_BOUNDARY_UNKNOWN" },
    { "id": "missing-parent", "failed": "child", "boundaries": [{ "id": "child", "parentId": "missing", "active": true, "emitted": false }], "error": "FADENO_STREAM_BOUNDARY_PARENT" },
    { "id": "boundary-cycle", "failed": "first", "boundaries": [{ "id": "first", "parentId": "second", "active": true, "emitted": false }, { "id": "second", "parentId": "first", "active": true, "emitted": false }], "error": "FADENO_STREAM_BOUNDARY_CYCLE" }
  ],
  "deadlineCases": [
