    { "id": "precommit-not-found", "operations": [{ "op": "fail", "kind": "not-found" }, { "op": "publish", "status": 404 }, { "op": "complete" }], "expected": { "phase": "completed", "status": 404, "writes": [], "closeCalls": 1, "abortCalls": [], "reports": [], "cleanupCalls": 1 } },
    { "id": "precommit-redirect", "operations": [{ "op": "fail", "kind": "redirect" }, { "op": "publish", "status": 303 }, { "op": "complete" }], "expected": { "phase": "completed", "status": 303, "writes": [], "closeCalls": 1, "abortCalls": [], "reports": [], "cleanupCalls": 1 } },
    { "id": "precommit-unexpected", "operations": [{ "op": "fail", "kind": "unexpected" }, { "op": "publish", "status": 500 }, { "op": "complete" }], "expected": { "phase": "completed", "status": 500, "writes": [], "closeCalls": 1, "abortCalls": [], "reports": [], "cleanupCalls": 1 } },
    { "id": "precommit-timeout", "operations": [{ "op": "fail", "kind": "timeout" }, { "op": "publish", "status": 504 }, { "op": "complete" }], "expected": { "phase": "completed", "status": 504, "writes": [], "closeCalls": 1, "abortCalls": [], "reports": [], "cleanupCalls": 1 } },
    { "id": "precommit-disconnect", "operations": [{ "op": "cancel", "reason": "disconnect" }], "expected": { "phase": "cancelled", "status": null, "writes": [], "closeCalls": 0, "abortCalls": [], "reports": [], "cleanupCalls": 1 } },
    { "id": "precommit-explicit", "operations": [{ "op": "cancel", "reason": "explicit" }], "expected": { "phase": "cancelled", "status": null, "writes": [], "closeCalls": 0, "abortCalls": [], "reports": [], "cleanupCalls": 1 } },
    { "id": "precommit-superseded", "operations": [{ "op": "cancel", "reason": "superseded" }], "expected": { "phase": "cancelled", "status": null, "writes": [], "closeCalls": 0, "abortCalls": [], "reports": [], "cleanupCalls": 1 } },
    { "id": "post-head-unexpected", "operations": [{ "op": "publish", "status": 200 }, { "op": "fail", "kind": "unexpected" }], "expected": { "phase": "terminated", "status": 200, "writes": [], "closeCalls": 0, "abortCalls": ["late-unexpected"], "reports": ["late-unexpected"], "cleanupCalls": 1 } },
    { "id": "post-body-not-found", "operations": [{ "op": "publish", "status": 200 }, { "op": "write", "chunk": "prefix" }, { "op": "fail", "kind": "not-found" }], "expected": { "phase": "terminated", "status": 200, "writes": ["prefix"], "closeCalls": 0, "abortCalls": ["late-not-found"], "reports": ["late-not-found"], "cleanupCalls": 1 } },
    { "id": "post-body-redirect", "operations": [{ "op": "publish", "status": 200 }, { "op": "write", "chunk": "prefix" }, { "op": "fail", "kind": "redirect" }], "expected": { "phase": "terminated", "status": 200, "writes": ["prefix"], "closeCalls": 0, "abortCalls": ["late-redirect"], "reports": ["late-redirect"], "cleanupCalls": 1 } },
    { "id": "post-body-timeout", "operations": [{ "op": "publish", "status": 200 }, { "op": "write", "chunk": "prefix" }, { "op": "fail", "kind": "timeout" }], "expected": { "phase": "terminated", "status": 200, "writes": ["prefix"], "closeCalls": 0, "abortCalls": ["late-timeout"], "reports": ["late-timeout"], "cleanupCalls": 1 } },
    { "id": "post-head-disconnect", "operations": [{ "op": "publish", "status": 200 }, { "op": "cancel", "reason": "disconnect" }], "expected": { "phase": "cancelled", "status": 200, "writes": [], "closeCalls": 0, "abortCalls": ["disconnect"], "reports": [], "cleanupCalls": 1 } },
    { "id": "post-body-explicit", "operations": [{ "op": "publish", "status": 200 }, { "op": "write", "chunk": "prefix" }, { "op": "cancel", "reason": "explicit" }], "expected": { "phase": "cancelled", "status": 200, "writes": ["prefix"], "closeCalls": 0, "abortCalls": ["explicit"], "reports": [], "cleanupCalls": 1 } },
    { "id": "post-body-superseded", "operations": [{ "op": "publish", "status": 200 }, { "op": "write", "chunk": "prefix" }, { "op": "cancel", "reason": "superseded" }], "expected": { "phase": "cancelled", "status": 200, "writes": ["prefix"], "closeCalls": 0, "abortCalls": ["superseded"], "reports": [], "cleanupCalls": 1 } }
