{
  "schema": "fadeno.example.action-ordering-fragment-redirect",
  "version": 1,
  "mutationRequests": 1,
  "privateRedirectGets": 0,
  "nativeDestinationGets": 1,
  "fragmentRedirectRuns": 1,
  "finalHash": "#details",
  "teardownFollowedHandoff": true,
  "freshCurrentTruthVisible": true,
  "historyFailureHandoff": {
    "calls": [
      "replace:/projects#details",
      "reload:/projects#details"
    ],
    "finalUrl": "/projects#details"
  }
}
